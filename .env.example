# ==============================================================================
# SYMBIOS Platform — Enterprise Environment Configuration (.env)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="SYMBIOS Industrial Safety Platform"
VERSION="2.0.0-enterprise"

# Cryptographic Security (HMAC-SHA256 Secret Key for JWT Signatures)
# In production, generate with: openssl rand -hex 32
SECRET_KEY=symbios-enterprise-safety-secret-key-change-in-production-32bytes-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Relational & Geospatial Database
# Production PostgreSQL with PostGIS:
DATABASE_URL=postgresql://symbios_user:symbios_secure_password_123!@localhost:5432/symbios_db
# Local development SQLite fallback:
# DATABASE_URL=sqlite:///./symbios_enterprise.db

# Message Queue (Redis Streams / PubSub)
REDIS_URL=redis://localhost:6379/0

# Tunable Ergonomic Fatigue Thresholds
FATIGUE_WINDOW_SECONDS=30
FATIGUE_SAMPLE_INTERVAL_MS=800
FATIGUE_SLUMP_THRESHOLD_DEGREES=18.0
FATIGUE_STILLNESS_THRESHOLD_SECONDS=8.0
FATIGUE_SCORE_MONITOR_THRESHOLD=35.0
FATIGUE_SCORE_CRITICAL_THRESHOLD=65.0

# Alert Escalation Daemon
ALERT_ESCALATION_MINUTES=3

# Explainability LLM Provider (Optional - falls back to deterministic engine if empty)
ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-...

# Data Privacy & Retention Policy (GDPR / Works Council)
RETAIN_RAW_VIDEO=false
SKELETAL_METRICS_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=1095

# External Enterprise Webhooks (Slack, Microsoft Teams)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
